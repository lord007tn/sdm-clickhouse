{
  "name": "sdm-clickhouse",
  "description": "Simple Desktop Manager for ClickHouse: an open-source desktop SQL workbench built with Tauri, React, TypeScript, and Rust.",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "author": "SDM ClickHouse contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lord007tn/sdm-clickhouse.git"
  },
  "bugs": {
    "url": "https://github.com/lord007tn/sdm-clickhouse/issues"
  },
  "homepage": "https://github.com/lord007tn/sdm-clickhouse#readme",
  "keywords": [
    "clickhouse",
    "desktop",
    "sql",
    "tauri",
    "react",
    "typescript",
    "rust",
    "database-client"
  ],
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check:tauri": "node scripts/check-tauri.mjs",
    "check:versions": "node scripts/check-version-consistency.mjs",
    "validate": "pnpm check:versions && pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm build && pnpm check:tauri",
    "knip": "knip",
    "knip:strict": "knip --production",
    "preview": "vite preview",
    "tauri": "pnpm dlx @tauri-apps/cli@2.10.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
